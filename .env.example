# ─── Database ────────────────────────────────────────────────
# Local development uses SQLite (a file next to the schema).
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL, e.g. Neon / Supabase) - see README "Deploy":
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ─── Site ────────────────────────────────────────────────────
# Public URL of the website (used for SEO, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Admin login (NextAuth) ──────────────────────────────────
# Generate a long random string, e.g.:  npx auth secret   or   openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Used ONLY by the seed script to create the first admin user.
ADMIN_EMAIL="amitkumardehriya@gmail.com"
ADMIN_PASSWORD="Deep@1234"
ADMIN_NAME="Dr. Deepmala Mourya"

# ─── Uploads (Cloudinary) ────────────────────────────────────
# Leave empty to store uploads on the local disk in ./uploads (development only).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="dr-deepmala-mourya"

# ─── Email notifications (Nodemailer / SMTP) ─────────────────
# Leave SMTP_HOST empty to just log notifications to the server console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Website <no-reply@example.com>"
# Where new inquiry / feedback notifications are sent (the doctor's email).
NOTIFY_EMAIL=""

# ─── Optional: Google reCAPTCHA v3 ───────────────────────────
# Leave both empty to disable. Honeypot + rate limiting are always on.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_MIN_SCORE="0.5"
